# Papinho em produção: atrás do Cloudflare Tunnel (TLS na Cloudflare), escuta só em loopback.
SERVER_ADDRESS=127.0.0.1
PAPINHO_PORT=54326
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/papinho
DATABASE_USERNAME=papinho
DATABASE_PASSWORD=<gere com: openssl rand -hex 24>
PAPINHO_DATA_DIR=/var/lib/papinho
PAPINHO_FORWARD_HEADERS=native
PAPINHO_HSTS=true
PAPINHO_RP_ID=papinho.cepify.com.br
PAPINHO_ALLOWED_ORIGINS=https://papinho.cepify.com.br
PAPINHO_PUBLIC_URL=https://papinho.cepify.com.br
PAPINHO_PUSH_SUBJECT=https://papinho.cepify.com.br
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
