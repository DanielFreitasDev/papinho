<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>io.github.labdev2025cmd</groupId>
    <artifactId>papinho</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>
    <name>papinho</name>
    <description>Chat web auto-hospedado: um único JAR serve o SPA, a API e o WebSocket (ADR 0002)</description>
    <url>https://github.com/DanielFreitasDev/papinho</url>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
            <comments>Com a permissão adicional da seção 7 para o AspectJ (NOTICE).</comments>
        </license>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <modules>
        <module>frontend</module>
        <module>backend</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <!-- Exatamente o conteúdo de frontend/.nvmrc (com o prefixo v) e de packageManager em frontend/package.json -->
        <node.version>v24.22.0</node.version>
        <pnpm.version>10.34.6</pnpm.version>
    </properties>
</project>
